<workout_file>
  <author>Emma</author>
  <name>W11 Thu - 6x1 at 100%</name>
  <description>Backup if you skip the social ride. If the nap's still going, keep riding easy in free ride once the workout ends. (35 min)</description>
  <sportType>bike</sportType>
  <category>Nap-Time Rides</category>
  <tags><tag name="Stronger"/></tags>
  <workout>
    <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.60"/>
    <IntervalsT Repeat="6" OnDuration="60" OffDuration="120" OnPower="1.00" OffPower="0.55">
      <textevent timeoffset="0" message="One minute hard, two easy."/>
    </IntervalsT>
    <SteadyState Duration="540" Power="0.62"/>
    <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.40">
      <textevent timeoffset="0" message="Pelvic floor time while you spin: 10 slow squeezes, hold up to 10 seconds, relax fully between."/>
      <textevent timeoffset="100" message="Now 10 quick squeezes: squeeze and let go."/>
      <textevent timeoffset="160" message="Done. Nice work."/>
    </Cooldown>
  </workout>
</workout_file>
