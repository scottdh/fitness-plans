<workout_file>
  <author>Emma</author>
  <name>W05 Thu - 3x5 tempo</name>
  <description>First tempo session. If the nap's still going, keep riding easy in free ride once the workout ends. (30 min)</description>
  <sportType>bike</sportType>
  <category>Nap-Time Rides</category>
  <tags><tag name="Build"/></tags>
  <workout>
    <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.60"/>
    <IntervalsT Repeat="3" OnDuration="300" OffDuration="120" OnPower="0.75" OffPower="0.55">
      <textevent timeoffset="0" message="Tempo: comfortably hard, short sentences only."/>
    </IntervalsT>
    <SteadyState Duration="60" Power="0.60"/>
    <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.40">
      <textevent timeoffset="0" message="Pelvic floor time while you spin: 10 slow squeezes, hold up to 10 seconds, relax fully between."/>
      <textevent timeoffset="100" message="Now 10 quick squeezes: squeeze and let go."/>
      <textevent timeoffset="160" message="Done. Nice work."/>
    </Cooldown>
  </workout>
</workout_file>
