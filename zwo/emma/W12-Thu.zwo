<workout_file>
  <author>Emma</author>
  <name>W12 Thu - Celebration ride</name>
  <description>Easy-to-steady ride, your choice of route. If the nap's still going, keep riding easy in free ride once the workout ends. (35 min)</description>
  <sportType>bike</sportType>
  <category>Nap-Time Rides</category>
  <tags><tag name="Stronger"/></tags>
  <workout>
    <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.60"/>
    <SteadyState Duration="600" Power="0.65"/>
    <IntervalsT Repeat="3" OnDuration="60" OffDuration="120" OnPower="0.95" OffPower="0.60">
      <textevent timeoffset="0" message="Three to finish, for fun."/>
    </IntervalsT>
    <SteadyState Duration="480" Power="0.62"/>
    <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.40">
      <textevent timeoffset="0" message="Pelvic floor time while you spin: 10 slow squeezes, hold up to 10 seconds, relax fully between."/>
      <textevent timeoffset="100" message="Now 10 quick squeezes: squeeze and let go."/>
      <textevent timeoffset="160" message="Done. Nice work."/>
    </Cooldown>
  </workout>
</workout_file>
