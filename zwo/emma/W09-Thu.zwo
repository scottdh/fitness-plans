<workout_file>
  <author>Emma</author>
  <name>W09 Thu - 3x3 at 88%</name>
  <description>Three 3' harder efforts. If the nap's still going, keep riding easy in free ride once the workout ends. (30 min)</description>
  <sportType>bike</sportType>
  <category>Nap-Time Rides</category>
  <tags><tag name="Stronger"/></tags>
  <workout>
    <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.60"/>
    <IntervalsT Repeat="3" OnDuration="180" OffDuration="120" OnPower="0.88" OffPower="0.55">
      <textevent timeoffset="0" message="Hard but controlled."/>
    </IntervalsT>
    <SteadyState Duration="420" Power="0.62"/>
    <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.40">
      <textevent timeoffset="0" message="Pelvic floor time while you spin: 10 slow squeezes, hold up to 10 seconds, relax fully between."/>
      <textevent timeoffset="100" message="Now 10 quick squeezes: squeeze and let go."/>
      <textevent timeoffset="160" message="Done. Nice work."/>
    </Cooldown>
  </workout>
</workout_file>
