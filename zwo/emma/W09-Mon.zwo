<workout_file>
  <author>Emma</author>
  <name>W09 Mon - 2x10 at 83%</name>
  <description>Two 10' blocks. If the nap's still going, keep riding easy in free ride once the workout ends. (34 min)</description>
  <sportType>bike</sportType>
  <category>Nap-Time Rides</category>
  <tags><tag name="Stronger"/></tags>
  <workout>
    <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.60"/>
    <IntervalsT Repeat="2" OnDuration="600" OffDuration="180" OnPower="0.83" OffPower="0.55">
      <textevent timeoffset="0" message="Strong and steady. You'll want this to end, but you can hold it."/>
    </IntervalsT>
    <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.40">
      <textevent timeoffset="0" message="Pelvic floor time while you spin: 10 slow squeezes, hold up to 10 seconds, relax fully between."/>
      <textevent timeoffset="100" message="Now 10 quick squeezes: squeeze and let go."/>
      <textevent timeoffset="160" message="Done. Nice work."/>
    </Cooldown>
  </workout>
</workout_file>
