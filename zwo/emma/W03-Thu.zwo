<workout_file>
  <author>Emma</author>
  <name>W03 Thu - Easy + 5x30s brisk</name>
  <description>Easy spin with five 30-second brisk bursts. If the nap's still going, keep riding easy in free ride once the workout ends. (25 min)</description>
  <sportType>bike</sportType>
  <category>Nap-Time Rides</category>
  <tags><tag name="Find your legs"/></tags>
  <workout>
    <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.60"/>
    <SteadyState Duration="420" Power="0.62"/>
    <IntervalsT Repeat="5" OnDuration="30" OffDuration="90" OnPower="0.85" OffPower="0.55">
      <textevent timeoffset="0" message="Brisk: breathing harder, then easy."/>
    </IntervalsT>
    <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.40">
      <textevent timeoffset="0" message="Pelvic floor time while you spin: 10 slow squeezes, hold up to 10 seconds, relax fully between."/>
      <textevent timeoffset="100" message="Now 10 quick squeezes: squeeze and let go."/>
      <textevent timeoffset="160" message="Done. Nice work."/>
    </Cooldown>
  </workout>
</workout_file>
