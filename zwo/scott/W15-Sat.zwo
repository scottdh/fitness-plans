<workout_file>
  <author>Scott</author>
  <name>W15 Sat - Z2 135 tempo finish</name>
  <description>Long ride, last 20 min at tempo. (135 min)</description>
  <sportType>bike</sportType>
  <category>Spring Build</category>
  <tags><tag name="Group-ride"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.65"/>
    <SteadyState Duration="6000" Power="0.65"/>
    <SteadyState Duration="1200" Power="0.80">
      <textevent timeoffset="0" message="Tempo finish. Ride it like the end of a club ride."/>
    </SteadyState>
    <Cooldown Duration="300" PowerLow="0.62" PowerHigh="0.40"/>
  </workout>
</workout_file>
