<workout_file>
  <author>Scott</author>
  <name>W06 Sat - Z2 + 3x10 tempo</name>
  <description>Long ride with tempo. (90 min)</description>
  <sportType>bike</sportType>
  <category>Spring Build</category>
  <tags><tag name="Engine"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.65"/>
    <SteadyState Duration="600" Power="0.65"/>
    <IntervalsT Repeat="3" OnDuration="600" OffDuration="300" OnPower="0.80" OffPower="0.60">
      <textevent timeoffset="0" message="Tempo: steady, focused, still able to speak in short phrases."/>
    </IntervalsT>
    <SteadyState Duration="1200" Power="0.65"/>
    <Cooldown Duration="300" PowerLow="0.62" PowerHigh="0.40"/>
  </workout>
</workout_file>
