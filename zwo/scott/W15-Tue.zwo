<workout_file>
  <author>Scott</author>
  <name>W15 Tue - 3x12 over-unders</name>
  <description>Over-unders. (50 min)</description>
  <sportType>bike</sportType>
  <category>Spring Build</category>
  <tags><tag name="Group-ride"/></tags>
  <workout>
    <Warmup Duration="360" PowerLow="0.45" PowerHigh="0.65"/>
    <IntervalsT Repeat="4" OnDuration="120" OffDuration="60" OnPower="0.95" OffPower="1.05">
      <textevent timeoffset="0" message="Over-unders: 2' just under threshold, 1' just over. Stay seated."/>
    </IntervalsT>
    <SteadyState Duration="180" Power="0.55">
      <textevent timeoffset="0" message="Easy spin."/>
    </SteadyState>
    <IntervalsT Repeat="4" OnDuration="120" OffDuration="60" OnPower="0.95" OffPower="1.05">
      <textevent timeoffset="0" message="Over-unders: 2' just under threshold, 1' just over. Stay seated."/>
    </IntervalsT>
    <SteadyState Duration="180" Power="0.55">
      <textevent timeoffset="0" message="Easy spin."/>
    </SteadyState>
    <IntervalsT Repeat="4" OnDuration="120" OffDuration="60" OnPower="0.95" OffPower="1.05">
      <textevent timeoffset="0" message="Over-unders: 2' just under threshold, 1' just over. Stay seated."/>
    </IntervalsT>
    <Cooldown Duration="120" PowerLow="0.62" PowerHigh="0.40"/>
  </workout>
</workout_file>
