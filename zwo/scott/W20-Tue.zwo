<workout_file>
  <author>Scott</author>
  <name>W20 Tue - Openers</name>
  <description>Openers. (40 min)</description>
  <sportType>bike</sportType>
  <category>Spring Build</category>
  <tags><tag name="Group-ride"/></tags>
  <workout>
    <Warmup Duration="720" PowerLow="0.45" PowerHigh="0.65"/>
    <IntervalsT Repeat="3" OnDuration="120" OffDuration="180" OnPower="1.05" OffPower="0.55">
      <textevent timeoffset="0" message="Openers: wake the legs up, don't dig deep."/>
    </IntervalsT>
    <FreeRide Duration="15" FlatRoad="1">
      <textevent timeoffset="0" message="Sprint! Out of the saddle."/>
    </FreeRide>
    <SteadyState Duration="165.0" Power="0.55"/>
    <FreeRide Duration="15" FlatRoad="1">
      <textevent timeoffset="0" message="Sprint! Out of the saddle."/>
    </FreeRide>
    <SteadyState Duration="165.0" Power="0.55"/>
    <FreeRide Duration="15" FlatRoad="1">
      <textevent timeoffset="0" message="Sprint! Out of the saddle."/>
    </FreeRide>
    <SteadyState Duration="165.0" Power="0.55"/>
    <Cooldown Duration="240" PowerLow="0.62" PowerHigh="0.40"/>
  </workout>
</workout_file>
