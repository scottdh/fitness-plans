<workout_file>
  <author>Scott</author>
  <name>W18 Tue - 2x12 SS + 6x1 at 120</name>
  <description>Sweet spot then surges. (50 min)</description>
  <sportType>bike</sportType>
  <category>Spring Build</category>
  <tags><tag name="Group-ride"/></tags>
  <workout>
    <Warmup Duration="360" PowerLow="0.45" PowerHigh="0.65"/>
    <SteadyState Duration="720" Power="0.90">
      <textevent timeoffset="0" message="Sweet spot. Comfortably hard, steady breathing."/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.55">
      <textevent timeoffset="0" message="Easy spin."/>
    </SteadyState>
    <SteadyState Duration="720" Power="0.90">
      <textevent timeoffset="0" message="Sweet spot. Comfortably hard, steady breathing."/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.55">
      <textevent timeoffset="0" message="Easy spin."/>
    </SteadyState>
    <IntervalsT Repeat="6" OnDuration="60" OffDuration="60" OnPower="1.20" OffPower="0.50">
      <textevent timeoffset="0" message="Surges: like closing a gap."/>
    </IntervalsT>
    <Cooldown Duration="120" PowerLow="0.62" PowerHigh="0.40"/>
  </workout>
</workout_file>
