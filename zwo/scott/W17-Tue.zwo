<workout_file>
  <author>Scott</author>
  <name>W17 Tue - 3 sets 10x30-30</name>
  <description>Surge training. (49 min)</description>
  <sportType>bike</sportType>
  <category>Spring Build</category>
  <tags><tag name="Group-ride"/></tags>
  <workout>
    <Warmup Duration="480" PowerLow="0.45" PowerHigh="0.65"/>
    <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.20" OffPower="0.50">
      <textevent timeoffset="0" message="30/30s: hard but controlled. Same power every rep. Try ERG off if cadence sags."/>
    </IntervalsT>
    <SteadyState Duration="240" Power="0.55">
      <textevent timeoffset="0" message="Easy spin."/>
    </SteadyState>
    <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.20" OffPower="0.50">
      <textevent timeoffset="0" message="30/30s: hard but controlled. Same power every rep. Try ERG off if cadence sags."/>
    </IntervalsT>
    <SteadyState Duration="240" Power="0.55">
      <textevent timeoffset="0" message="Easy spin."/>
    </SteadyState>
    <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.20" OffPower="0.50">
      <textevent timeoffset="0" message="30/30s: hard but controlled. Same power every rep. Try ERG off if cadence sags."/>
    </IntervalsT>
    <Cooldown Duration="180" PowerLow="0.62" PowerHigh="0.40"/>
  </workout>
</workout_file>
