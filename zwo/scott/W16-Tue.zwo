<workout_file>
  <author>Scott</author>
  <name>W16 Tue - Z2 + 3x1 at 110</name>
  <description>Deload week. (45 min)</description>
  <sportType>bike</sportType>
  <category>Spring Build</category>
  <tags><tag name="Group-ride"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.65"/>
    <SteadyState Duration="600" Power="0.65"/>
    <IntervalsT Repeat="3" OnDuration="60" OffDuration="180" OnPower="1.10" OffPower="0.60">
      <textevent timeoffset="0" message="Short, sharp, then easy."/>
    </IntervalsT>
    <SteadyState Duration="480" Power="0.65"/>
    <Cooldown Duration="300" PowerLow="0.62" PowerHigh="0.40"/>
  </workout>
</workout_file>
